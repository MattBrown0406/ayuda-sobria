# Server-only registration email configuration (Cloudflare/Lovable secrets)
RESEND_API_KEY=
REGISTRATION_FROM_EMAIL="AyudaSobria <registro@ayudasobria.com>"
REGISTRATION_TO_EMAIL=matt@soberhelpline.com

# Supabase. Lovable Cloud injects these automatically; set them by hand only for
# local runs or a deploy outside Lovable. The service-role key is server-only and
# must never be exposed to the browser or prefixed with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal (server-side only) — required by membership subscriptions and coaching checkout
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
# Optional. Pin an existing PayPal catalog product and billing plans so the app
# reuses them instead of creating a new (permanent, non-deletable) plan whenever
# a worker starts cold. Recommended in production once the plans exist.
PAYPAL_PRODUCT_ID=
PAYPAL_PLAN_ID_MONTHLY=
PAYPAL_PLAN_ID_ANNUAL=

# AyudaSobria La Sobremesa Zoom lifecycle (all server-side; never prefix with VITE_)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_AUTOMATION_SECRET=

# Optional email-provider fallback used by the server-side Zoom mailer
LOVABLE_API_KEY=
